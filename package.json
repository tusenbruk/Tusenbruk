{
  "name": "tusenbruk",
  "version": "1.0.0",
  "private": true,
  "description": "Tusenbruk \u2014 the art of using things well crafted.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:content",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "validate:content": "node scripts/validate_content.mjs",
    "social:assets": "python3 scripts/make_social_assets.py",
    "validate:social": "python3 scripts/make_social_assets.py --check",
    "validate:metadata": "python3 scripts/strip_metadata.py --check public/photos public/illustrations public/cards social/output social/brand",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
